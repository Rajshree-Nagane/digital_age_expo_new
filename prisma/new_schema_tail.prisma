
// =====================================================================================
// ADMIN CONTROL PANEL (CP) — /src/app/cp
// -------------------------------------------------------------------------------------
// REVISED after checking the live `connectlocal_website` database against the legacy
// admin CP's own PHP source (cp/admin_index.php, admin_permissions.php, admin_users.php,
// admin_users_groups.php). Ground truth found there: the legacy admin panel does NOT
// have its own identity system — it authenticates against the SAME `find_users` table
// the member portal already uses, and authorizes via a "groups" system:
//   - find_users_groups                    — a group IS a role (Super Admin, Admin, ...)
//   - find_users_groups_lookup             — which user(s) belong to which group(s)
//   - find_users_permissions               — catalog of permission slugs (e.g.
//                                             "admin_users_edit", "admin_users_groups_view")
//   - find_users_groups_permissions_lookup — which permissions a group grants
//   - find_settings                        — DOMAIN-scoped key/value settings store,
//                                             grouped by `grouptitle` (General/Company/
//                                             Branding/SEO/Social/...) — this *is* the
//                                             legacy Project Settings backing store.
//   - find_dashboard_menu                  — the legacy admin CP's own sidebar links,
//                                             role/permission gated — reused to drive
//                                             this CP's sidebar instead of hardcoding it.
//   - find_event_menus                     — backs the Member Menu Manager module.
//   - find_menu_links (already present above) — backs the general site Menu Manager.
//
// So Phase 1 below reuses all of the above instead of the parallel cp_roles/
// cp_permissions/cp_role_permissions/cp_admin_users/cp_settings_* tables originally
// drafted here. Only three genuinely NEW tables remain, for the one thing the legacy
// system has no equivalent of:
//   - cp_admin_credentials — the legacy password hash format (find_users.pass/
//     password_salt/password_hash) is produced by this framework's own encoded core
//     (see the ioncubebkp/ directory — the verification routine isn't readable source),
//     so it can't be safely replicated or verified against here. Rather than guess at a
//     security-critical algorithm, admin (CP) login gets its own scrypt-hashed
//     credential row, 1:1 with a find_users.id — identity, profile, roles, and
//     permissions all still live on the existing tables; only the CP login secret is new.
//   - cp_password_resets   — forgot-password tokens for that same CP login.
//   - cp_audit_logs        — structured audit trail; nothing in the legacy schema plays
//     this role (its "logs" tables are all feature-specific, e.g. find_email_queue).
// =====================================================================================

model find_users_groups {
  id            Int     @id @default(autoincrement())
  name          String  @db.VarChar(150)
  description   String? @db.Text
  administrator Int     @db.UnsignedTinyInt
  advertiser    Int     @db.UnsignedTinyInt
  user          Int     @db.UnsignedTinyInt

  @@map("find_users_groups")
}

model find_users_groups_lookup {
  user_id  Int @db.UnsignedInt
  group_id Int @db.UnsignedInt

  @@id([user_id, group_id])
  @@index([group_id], map: "group_id")
  @@index([user_id], map: "user_id")
  @@map("find_users_groups_lookup")
}

model find_users_permissions {
  id String @id @db.VarChar(150)

  @@map("find_users_permissions")
}

model find_users_groups_permissions_lookup {
  group_id      Int    @db.UnsignedInt
  permission_id String @db.VarChar(150)

  @@id([group_id, permission_id])
  @@map("find_users_groups_permissions_lookup")
}

/// EAV settings store, DOMAIN-scoped (multi-site). No unique key on (varname, DOMAIN) is
/// enforced at the DB level (legacy inserts-if-missing / updates-if-present in app code),
/// so this stays @@ignore'd — same as it was in the original introspection — and is read/
/// written through lib/cp/settings/settingsRepository.ts via $queryRaw/$executeRaw rather
/// than the normal Prisma delegate. grouptitle is how the legacy admin_settings.php (and
/// this CP's Project Settings module) partitions rows into General/Company/Branding/SEO/
/// Social/Theme sections.
model find_settings {
  varname               String                              @db.VarChar(300)
  grouptitle            String                              @db.VarChar(150)
  value                 String?                             @db.MediumText
  optioncode            String?                             @db.MediumText
  optioncode_type       find_settings_optioncode_type
  optioncode_parse_type find_settings_optioncode_parse_type
  validationcode        String?                             @db.Text
  DOMAIN                Int?                                @default(1)

  @@index([DOMAIN], map: "IDX_SETTINGS_DOMAIN")
  @@index([grouptitle], map: "idx_find_settings_grouptitle")
  @@index([varname, DOMAIN], map: "idx_find_settings_varname_domain")
  @@ignore
}

enum find_settings_optioncode_type {
  text
  textarea
  select
  radio
  checkbox
  file
  eval
  text_tags
  number_toggle
}

enum find_settings_optioncode_parse_type {
  static
  eval_options
  eval
}

/// The legacy admin CP's own sidebar: role/permission-gated links. Reused to drive this
/// CP's sidebar dynamically instead of a hardcoded nav array.
model find_dashboard_menu {
  id               Int      @id @default(autoincrement())
  title            String   @db.VarChar(255)
  icon             String   @db.VarChar(255)
  page_name        String   @db.VarChar(255)
  color            String   @db.VarChar(255)
  link             String   @db.VarChar(255)
  visible          Boolean
  url_type         String?  @default("UTM") @db.VarChar(255)
  orderby          Int      @default(0)
  advertiser       Boolean
  seller           Boolean
  franchise        Boolean
  admin            Boolean? @default(true)
  domain           String?  @db.Text
  hide_domain      String?  @db.Text
  check_permission Int?     @default(0) @db.TinyInt
  permission       String?  @db.VarChar(255)
  menu_group       String?  @db.VarChar(25)
  target           String?  @db.VarChar(255)
  affiliate        Int?     @default(0) @db.TinyInt
  zonal            Int?     @default(0) @db.TinyInt
  regional         Int?     @default(0) @db.TinyInt

  @@map("find_dashboard_menu")
}

/// Backs the "Member Menu Manager" module (separate from find_menu_links, which backs the
/// general site Menu Manager and was already in use elsewhere in this app).
model find_event_menus {
  id             Int     @id @default(autoincrement())
  menu_type      String? @db.VarChar(255)
  title          String? @db.VarChar(255)
  color          String? @default("primary") @db.VarChar(255)
  sequence       Int?
  event_category String  @db.VarChar(255)
  icon           String  @db.VarChar(255)
  icon_mstr_cd   String? @db.VarChar(255)
  page_name      String  @db.VarChar(255)
  link           String  @db.VarChar(255)
  is_modal       Int?    @default(0) @db.TinyInt
  modal_name     String? @db.VarChar(50)
  visitor        Boolean
  organiser      Boolean
  exhibitor      Boolean
  sponsor        Boolean
  speaker        Boolean
  partner        Int     @db.TinyInt
  marketer       Int     @db.TinyInt
  visible        Boolean
  attribute      String? @db.VarChar(255)
  menu_group     String? @db.VarChar(255)

  @@map("find_event_menus")
}

/// The one piece with no legacy equivalent: this CP's own login secret, 1:1 with a
/// find_users row. See the block comment above for why this isn't stored on find_users.pass.
model cp_admin_credentials {
  id            Int       @id @default(autoincrement())
  find_user_id  Int       @unique
  password_hash String    @db.VarChar(255)
  is_active     Boolean   @default(true)
  last_login_at DateTime?
  last_login_ip String?   @db.VarChar(64)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  created_by    Int?
  updated_by    Int?

  @@map("cp_admin_credentials")
}

model cp_password_resets {
  id           Int       @id @default(autoincrement())
  find_user_id Int
  /// SHA-256 hash of the token — the raw token only ever exists in the emailed link.
  token_hash   String    @unique @db.VarChar(64)
  expires_at   DateTime
  used_at      DateTime?
  created_at   DateTime  @default(now())

  @@index([find_user_id])
  @@map("cp_password_resets")
}

model cp_audit_logs {
  id            Int      @id @default(autoincrement())
  /// References find_users.id informally (no formal Prisma relation — same convention
  /// as every other user_id-style column against the huge find_users model in this schema).
  admin_user_id Int?
  /// login | logout | create | update | delete | ...
  action        String   @db.VarChar(50)
  /// e.g. "settings.general", "admin_users" — the module a change belongs to.
  module        String   @db.VarChar(100)
  entity_type   String?  @db.VarChar(100)
  entity_id     String?  @db.VarChar(100)
  before_json   String?  @db.LongText
  after_json    String?  @db.LongText
  ip_address    String?  @db.VarChar(64)
  user_agent    String?  @db.VarChar(255)
  created_at    DateTime @default(now())

  @@index([module])
  @@index([admin_user_id])
  @@map("cp_audit_logs")
}
