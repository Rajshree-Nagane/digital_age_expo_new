  check_permission Int?     @default(0) @db.TinyInt
  permission       String?  @db.VarChar(255)
  menu_group       String?  @db.VarChar(25)
  target           String?  @db.VarChar(255)
  affiliate        Int?     @default(0) @db.TinyInt
  zonal            Int?     @default(0) @db.TinyInt
  regional         Int?     @default(0) @db.TinyInt

  @@map("find_dashboard_menu")
}

/// Backs the "Member Menu Manager" module (separate from find_menu_links, which backs the
/// general site Menu Manager and was already in use elsewhere in this app).
model find_event_menus {
  id             Int     @id @default(autoincrement())
  menu_type      String? @db.VarChar(255)
  title          String? @db.VarChar(255)
  color          String? @default("primary") @db.VarChar(255)
  sequence       Int?
  event_category String  @db.VarChar(255)
  icon           String  @db.VarChar(255)
  icon_mstr_cd   String? @db.VarChar(255)
  page_name      String  @db.VarChar(255)
  link           String  @db.VarChar(255)
  is_modal       Int?    @default(0) @db.TinyInt
  modal_name     String? @db.VarChar(50)
  visitor        Boolean
  organiser      Boolean
  exhibitor      Boolean
  sponsor        Boolean
  speaker        Boolean
  partner        Int     @db.TinyInt
  marketer       Int     @db.TinyInt
  visible        Boolean
  attribute      String? @db.VarChar(255)
  menu_group     String? @db.VarChar(255)

  @@map("find_event_menus")
}

model cp_password_resets {
  id           Int       @id @default(autoincrement())
  find_user_id Int
  /// SHA-256 hash of the token — the raw token only ever exists in the emailed link.
  token_hash   String    @unique @db.VarChar(64)
  expires_at   DateTime
  used_at      DateTime?
  created_at   DateTime  @default(now())

  @@index([find_user_id])
  @@map("cp_password_resets")
}

model cp_audit_logs {
  id            Int      @id @default(autoincrement())
  /// References find_users.id informally (no formal Prisma relation — same convention
  /// as every other user_id-style column against the huge find_users model in this schema).
  admin_user_id Int?
  /// login | logout | create | update | delete | ...
  action        String   @db.VarChar(50)
  /// e.g. "settings.general", "admin_users" — the module a change belongs to.
  module        String   @db.VarChar(100)
  entity_type   String?  @db.VarChar(100)
  entity_id     String?  @db.VarChar(100)
  before_json   String?  @db.LongText
  after_json    String?  @db.LongText
  ip_address    String?  @db.VarChar(64)
  user_agent    String?  @db.VarChar(255)
  created_at    DateTime @default(now())

  @@index([module])
  @@index([admin_user_id])
  @@map("cp_audit_logs")
}

/// Backs the Email Template Builder module. find_email_templates already exists in
/// connectlocal_website (it's the legacy template metadata catalog: recipients/from/reply/
/// disable/moderate/priority) but has no subject/body columns of its own — this framework's
/// email content instead flows through a separate phrases table (find_language_phrases) using
/// a per-page/per-context variable-naming convention this session can't verify without live
/// data (no DB access from this sandbox), so guessing at that convention risked creating
/// phrase rows that don't actually match what any real code looks up. `subject` and
/// `body_html` below are two GENUINELY NEW nullable columns added to this existing table
/// instead — safe or ambiguous, given nothing in this Next.js app sends email yet, there's no
/// existing behavior to conflict with. See prisma/cp_email_templates_columns.sql for the
/// (additive, non-destructive) ALTER TABLE statements — same "no db push" discipline as the
/// rest of this CP's schema changes.
model find_email_templates {
  id                String    @id @db.VarChar(765)
  type              String    @db.VarChar(165)
  recipients        String?   @db.Text
  recipients_bcc    String?   @db.Text
  from_address      String?   @db.VarChar(150)
  from_name         String?   @db.VarChar(150)
  reply_name        String?   @db.VarChar(150)
  reply_address     String?   @db.VarChar(150)
  disable           Int       @db.UnsignedTinyInt
  moderate          Int       @db.UnsignedTinyInt
  attachments       String?   @db.Text
  custom            Int       @db.UnsignedTinyInt
  process_name      String?   @db.Text
  action_btn_name   String?   @db.VarChar(255)
  priority_order    Int?
  date              DateTime  @default(now()) @db.Timestamp(0)
  is_non_franchise  Boolean   @default(false)
  is_admin          Boolean?  @default(true)
  event_category_id Int?
  created_by        Int?
  created_on        DateTime? @default(now()) @db.DateTime(0)
  updated_by        Int?
  updated_on        DateTime? @db.DateTime(0)
  /// NEW — not part of the original legacy table. Nullable so existing rows need no backfill.
  subject           String?   @db.VarChar(500)
  /// NEW — not part of the original legacy table. Nullable so existing rows need no backfill.
  body_html         String?   @db.LongText

  @@index([type], map: "type")
}
