generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model common_type {
  id                   Int      @id @default(autoincrement())
  typ_cd               String   @unique(map: "TYP_CD") @db.VarChar(10)
  typ_nm               String?  @db.VarChar(50)
  typ_desc             String?  @db.VarChar(500)
  parent_desc_id       Int?
  additional_parent_id String?  @db.VarChar(255)
  is_editable          Boolean? @default(true)
  is_predefined        Boolean? @default(true)
  table_type           String?  @db.VarChar(10)
  typ_url_id           Int?
  user_master_data     Int?     @default(0) @db.TinyInt

  @@index([id], map: "IDX_CT_PARENTTYPID")
}

